# =============================================================================
# Bila UiTM Cuti Chat — local env template
# Copy to .env.local and fill in real values before `pnpm dev`:
#   copy .env.example .env.local   (Windows)
#   cp .env.example .env.local     (macOS/Linux)
# Do not commit .env.local. Secrets for production go in Worker secrets / wrangler.
# =============================================================================

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (anti-bot on chat)
# -----------------------------------------------------------------------------
# Site key: set NEXT_PUBLIC_* so it is inlined at build, OR TURNSTILE_SITE_KEY
# at runtime (client loads via GET /api/turnstile/config).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
# TURNSTILE_SITE_KEY=your_turnstile_site_key_here
# Secret must stay server-only (Worker secret in production).
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# -----------------------------------------------------------------------------
# Calendar API (server-only)
# -----------------------------------------------------------------------------
# Upstream origin for UiTM academic calendar data used by chat tools + session UI.
# Browser calls same-origin /api/v1/meta and /api/v1/calendar (proxy); server code
# and the chat agent call this base URL directly. Do not use NEXT_PUBLIC_* here.
# Docs: https://api.bilauitmcuti.com/docs
# OpenAPI: https://api.bilauitmcuti.com/api/openapi.json
# CALENDAR_API_BASE=https://api.bilauitmcuti.com

# -----------------------------------------------------------------------------
# Workers AI (no API key)
# -----------------------------------------------------------------------------
# Inference uses the Cloudflare Workers AI binding named "AI" in wrangler.jsonc.
# Local: `pnpm dev` via OpenNext initOpenNextCloudflareForDev + wrangler login.
# Preview/deploy: `pnpm preview` / `pnpm deploy` (OpenNext → Cloudflare Workers).
#
# Models (default Gemma 4; client picker in chat composer — see lib/chat/models.ts):
#   @cf/google/gemma-4-26b-a4b-it
# Optional server default override (must be allowlisted):
# WORKERS_AI_MODEL=@cf/google/gemma-4-26b-a4b-it
#
# Chat agent (tool calling). Set 0/false to disable globally (legacy full-context).
# CHAT_USE_AGENT=0

# -----------------------------------------------------------------------------
# AI Gateway (chat inference)
# -----------------------------------------------------------------------------
# Create gateway "buc-chat" in Cloudflare dashboard: AI → AI Gateway.
# Also set in wrangler.jsonc vars for Workers deploys. Set to "off" to bypass.
# AI_GATEWAY_ID=buc-chat
# SKIP_AI_GATEWAY=1

# -----------------------------------------------------------------------------
# Discord webhooks (server-only; chat thumbs up/down)
# -----------------------------------------------------------------------------
# Do not commit real URLs. Optional — chat feedback still works without them.
DISCORD_WEBHOOK_CHAT_HELPFUL=https://discord.com/api/webhooks/your_chat_helpful_id/your_token
DISCORD_WEBHOOK_CHAT_NOT_HELPFUL=https://discord.com/api/webhooks/your_chat_not_helpful_id/your_token

# -----------------------------------------------------------------------------
# Local-only helpers
# -----------------------------------------------------------------------------
# Skip Cloudflare bindings in next dev (UI only; chat returns 503 without AI):
# SKIP_CLOUDFLARE_DEV=1
