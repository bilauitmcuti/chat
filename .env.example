# =============================================================================
# Bila UiTM Cuti Chat — local env template (DUMMY PLACEHOLDERS ONLY)
# Copy to .env.local and replace every CHANGE_ME / example value with real ones:
#   copy .env.example .env.local   (Windows)
#   cp .env.example .env.local     (macOS/Linux)
# Do not commit .env.local. Production secrets → Worker secrets / wrangler.
# =============================================================================

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (anti-bot on chat)
# -----------------------------------------------------------------------------
# Site key: NEXT_PUBLIC_* is inlined at build, OR TURNSTILE_SITE_KEY at runtime
# (client loads via GET /api/turnstile/config).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAACHANGE_ME_SITE_KEY
# TURNSTILE_SITE_KEY=0x4AAAAAACHANGE_ME_SITE_KEY
# Secret must stay server-only (Worker secret in production).
TURNSTILE_SECRET_KEY=0x4AAAAAACHANGE_ME_SECRET_KEY

# -----------------------------------------------------------------------------
# Calendar API (server-only)
# -----------------------------------------------------------------------------
# Upstream origin for UiTM academic calendar (chat tools + session UI).
# Browser uses same-origin /api/v1/meta and /api/v1/calendar; server calls this base.
# Docs: https://api.bilauitmcuti.com/docs
# OpenAPI: https://api.bilauitmcuti.com/api/openapi.json
# CALENDAR_API_BASE=https://api.example.com

# -----------------------------------------------------------------------------
# Workers AI (no API key)
# -----------------------------------------------------------------------------
# Binding "AI" in wrangler.jsonc. Local: pnpm dev + wrangler login.
# Default model Gemma 4; composer picker — see lib/chat/models.ts.
# WORKERS_AI_MODEL=@cf/example/change-me-model-id
# CHAT_USE_AGENT=0
# Soft-JSON language classify when heuristic confidence is low (off by default)
# CHAT_LANGUAGE_LLM=1

# -----------------------------------------------------------------------------
# AI Gateway (chat inference)
# -----------------------------------------------------------------------------
# Create the gateway in Cloudflare: AI → AI Gateway. Production name: buc-chat.
# Also declared in wrangler.jsonc vars. Set to "off" to bypass.
AI_GATEWAY_ID=gateway-chat
# SKIP_AI_GATEWAY=1
# Opt-in Dynamic Routes for all picker models including Gemma (default off).
# CHAT_USE_DYNAMIC_ROUTES=1

# -----------------------------------------------------------------------------
# Discord webhooks (server-only; chat thumbs up/down)
# -----------------------------------------------------------------------------
# Optional — feedback UI works without these; delivery needs real webhook URLs.
DISCORD_WEBHOOK_CHAT_HELPFUL=https://discord.com/api/webhooks/000000000000000000/CHANGE_ME_HELPFUL_TOKEN
DISCORD_WEBHOOK_CHAT_NOT_HELPFUL=https://discord.com/api/webhooks/000000000000000000/CHANGE_ME_NOT_HELPFUL_TOKEN

# -----------------------------------------------------------------------------
# Local-only helpers
# -----------------------------------------------------------------------------
# SKIP_CLOUDFLARE_DEV=1
